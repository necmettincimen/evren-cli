# EVREN LLM API Anahtarı (Format: evren_llm_...)
EVREN_API_KEY=evren_llm_your_api_key_here

# Çoklu API Anahtarı (isteğe bağlı, virgülle ayrılır). Kota dolunca otomatik geçiş yapılır.
# EVREN_API_KEYS=evren_llm_key1,evren_llm_key2,evren_llm_key3

# EVREN LLM Base URL
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# Varsayılan Kodlama Modeli (Önerilen: deepseek-v4.1-flash veya glm-5.3)
EVREN_DEFAULT_MODEL=deepseek-v4.1-flash

# Maksimum Çıktı Tokenı (Akıl yürüten modellerde en az 2048, önerilen 4096)
# Daha çok kod üretmesi için 8192 önerilir.
EVREN_DEFAULT_MAX_TOKENS=8192

# Model Sıcaklığı (Kod için 0.2 - 0.5 önerilir)
EVREN_DEFAULT_TEMPERATURE=0.3

# Reasoning (düşünme) yoğunluğu: low | medium | high | none
# Reasoning modelleri (deepseek-v4.1-flash, glm-5.3) görünmez bir düşünme akışı
# üretir ve bu token'lar kod çıktısıyla aynı bütçeyi paylaşır.
# low = daha hızlı yanıt + koda daha çok token (önerilen). none = sunucu varsayılanı.
EVREN_REASONING_EFFORT=low

# Otomatik Onay Modu (True ise dosya yazma ve komut çalıştırmadan önce sormaz - dikkatli kullanın)
EVREN_AUTO_APPROVE=false

# SSH Uzak Sunucu Ayarları (isteğe bağlı)
# Uzak komutlar için varsayılan zaman aşımı (saniye, en fazla 600)
# EVREN_SSH_TIMEOUT=60
# Özel SSH host kayıt defteri yolu (varsayılan: ~/.evren/ssh_hosts.json)
# EVREN_SSH_CONFIG=C:\Users\me\.evren\ssh_hosts.json

# SSL/TLS Doğrulama Ayarları
# Self-signed veya kurumsal (MITM) sertifika hatası alıyorsanız:
#   1) Tercih edilen: Kurumsal/kök CA sertifikanızın PEM dosya yolunu verin.
# EVREN_CA_BUNDLE=C:\certs\corporate-ca.pem
#   2) Alternatif: Doğrulamayı tamamen kapatın (yalnızca güvendiğiniz ağlarda kullanın).
# EVREN_SSL_VERIFY=false
